{
  "type": "module",
  "name": "@oh-my-pi/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OMP Desktop app — Tauri shell over the omp coding agent (RPC sidecar)",
  "homepage": "https://omp.sh",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar": "bun scripts/build-sidecar.ts",
    "bundle": "bun run sidecar && tauri build",
    "check": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "marked": "catalog:",
    "@oh-my-pi/collab-web": "workspace:*",
    "@oh-my-pi/pi-wire": "catalog:",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
