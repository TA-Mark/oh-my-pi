{
  "type": "module",
  "name": "@oh-my-pi/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OMP Desktop app — Tauri shell over the omp coding agent (RPC sidecar)",
  "homepage": "https://omp.sh",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar": "bun scripts/build-sidecar.ts",
    "bundle": "bun run sidecar && tauri build",
    "check": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.test.json --noEmit",
    "test": "bun test test/",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "smoke": "bun scripts/smoke-rpc.ts",
    "smoke:sidecar": "bun scripts/smoke-rpc.ts --sidecar",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "lint": "biome lint .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "marked": "catalog:",
    "lucide-react": "catalog:",
    "@oh-my-pi/collab-web": "workspace:*",
    "@oh-my-pi/pi-wire": "catalog:",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webdriverio": "^9.0.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
