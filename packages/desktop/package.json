{
  "type": "module",
  "name": "@oh-my-pi/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "description": "OMP Desktop app — Electron shell over the omp coding agent (RPC sidecar)",
  "homepage": "https://omp.sh",
  "author": "OMP contributors",
  "license": "MIT",
  "build": {
    "appId": "sh.omp.desktop",
    "productName": "OMP Desktop",
    "icon": "resources/icon.png",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "asarUnpack": ["**/node_modules/node-pty/**/*"],
    "npmRebuild": false,
    "extraResources": [{ "from": "resources", "to": "." }],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "msi"] },
    "mac": { "target": ["dmg"] }
  },
  "scripts": {
    "dev": "vite",
    "deps:ensure": "bun scripts/ensure-dependencies.ts",
    "build": "bun run deps:ensure && vite build",
    "preview": "vite preview",
    "electron:compile": "bun build ./electron/main.ts --outfile ./dist-electron/main.js --target node --format esm --external electron --external node-pty && bun build ./electron/preload.ts --outfile ./dist-electron/preload.cjs --target node --format cjs --external electron",
    "electron:dev": "bun run build && bun run electron:compile && electron .",
    "electron:build": "bun run build && bun run electron:compile && bun run sidecar && electron-builder",
    "sidecar": "bun scripts/build-sidecar.ts",
    "icon:use": "bun scripts/select-icon.ts",
    "bundle": "bun run electron:build",
    "check": "bun run deps:ensure && tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.test.json --noEmit",
    "test": "bun run deps:ensure && bun test test/",
    "smoke": "bun scripts/smoke-rpc.ts",
    "release:validate": "bun scripts/validate-packaged.ts",
    "lint": "biome lint .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "marked": "catalog:",
    "lucide-react": "catalog:",
    "@oh-my-pi/collab-web": "workspace:*",
    "@oh-my-pi/pi-wire": "catalog:",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "catalog:",
    "@types/electron": "^1.6.12",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "20.10.6",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": { "bun": ">=1.3.14" }
}
